{
  "name": "deflow",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev:be": "node --watch-path=server/server.js --watch-path=server/db.js server/server.js",
    "dev:fe": "npm run dev --prefix client",
    "dev": "npx concurrently \"npm run dev:be\" \"npm run dev:fe\"",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node -e \"require('./server/migrations').runMigrations().then(r => { console.log(r); process.exit(r.success ? 0 : 1); });\"",
    "db:backup": "node -e \"require('./server/backupService').createBackup('cli').then(r => { console.log(r); process.exit(0); });\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "sqlite3": "^6.0.1"
  }
}
